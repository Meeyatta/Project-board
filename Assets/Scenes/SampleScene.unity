--- !u!114 &1110162793617231621
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1110162793623304829}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 948c6eac03994cd49bad23b71ceeec7c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: Eplanations for each manager
  textList:
  - s: 'GameManager - Main thing, responsible for calling actions and also has

      some
      useful functions'
    state: 3
    show: 1
    deleteQuestion: 0
  - s: "GameplayManager - reasponsible for creating the \nbattlefield, placing starter
      player & enemy units and \nobjectives"
    state: 3
    show: 0
    deleteQuestion: 0
  - s: 'PlayerManager - holds reference to player resources

      like total/placed
      army units, '
    state: 3
    show: 0
    deleteQuestion: 0
  - s: "ScoreManager - Responsible for keeping track of \nplayer/enemy points and
      calls an event if a side won"
    state: 3
    show: 0
    deleteQuestion: 0
  - s: EnemyManager - Responsible for enemy deployment,
    state: 3
    show: 0
    deleteQuestion: 0
  - s: 'EffectManager - Responsible for holding visual effects

      and displaying
      them for specific actions'
    state: 3
    show: 0
    deleteQuestion: 0
  - s: 'CellCoverManager - Keeps track of water thing certain

      cells are coated
      in and applies abilities to units accordingly'
    state: 3
    show: 0
    deleteQuestion: 0
  - s: 'AbilityManager - Has a list of abilities and their effects,

      no practical
      functions so far'
    state: 3
    show: 0
    deleteQuestion: 0
  - s: InputManager - Holds new input system reference
    state: 3
    show: 0
    deleteQuestion: 0
  - s: 'CameraManager - allows player to change camera position

      with keys'
    state: 3
    show: 0
    deleteQuestion: 0
  - s: DialogueManager - Manages lines spoken by Jimbo
    state: 3
    show: 0
    deleteQuestion: 0
  - s: "AudioManager - stores all game sounds and plays \nthem on command"
    state: 3
    show: 0
    deleteQuestion: 0
  - s: 'BoardManager - Holds reference to current board

      and units on them'
    state: 3
    show: 1
    deleteQuestion: 0
  - s: "ClickManager - used to track what cells player clicks on and what \nactions
      they should invoke depending on the context"
    state: 3
    show: 1
    deleteQuestion: 0
  - s: 'RuleMessageManager - holds functions what visualize when player tries to

      break
      rules'
    state: 3
    show: 1
    deleteQuestion: 0
