    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: title
      value: Project board
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[0].s
      value: 'Break down Actions & ActionParameter into functions

        with different
        parameters'
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[1].s
      value: Merge Tutorial and Normal scene into one
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[2].s
      value: Make a good looking scene
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[3].s
      value: "Add the item system:\n\t1) Round starts\n\t2) Enemy deploys their units\n\t3)
        Camera lowers in front of the board\n\t4) 3 Possible units drawn from the
        left\n\t5) 2 Possible items drawn from right\n\t5.a) Clicking on an item
        places it in the\nitem zone\n\t5.b) Clicking on a unit makes player \nplace
        that unit on the board\n\t6) Player cannot pass or move units\nuntil they
        select both a new unit and an item"
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[4].s
      value: "Make items functional (Stopped at\nBucket and ClickManager, CellClickCoroutine
        needs \na better way to check between clicks)"
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[5].s
      value: 'Rework ability holders to be lists

        with individual sources '
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[6].s
      value: Assign unique cover effects in effectManager
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[7].s
      value: When placing a unit, all placement efects disappear
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[8].s
      value: Amphibia-man doesn't slide
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[9].s
      value: Add sounds & animation for units being damaged
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[10].s
      value: Weird issues with multicell units moving towards the objectives
      objectReference: {fileID: 0}
    - target: {fileID: 11416984, guid: c080686877cf77f42a1a078076d57fe5, type: 3}
      propertyPath: textList.Array.data[11].s
      value: Weird issues with multicell units moving towards the objectives
      objectReference: {fileID: 0}
